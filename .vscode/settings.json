{
	// Appearance - easy to identify this Workspace
	"workbench.colorCustomizations": {
		// Title Bar
		"titleBar.activeBackground": "#68350b",
		"titleBar.activeForeground": "#b89578",
		"titleBar.inactiveBackground": "#68350b",
		"titleBar.inactiveForeground": "#b89578",
		// Activty bar (left icons)
		"activityBar.background": "#68350b",
		"activityBar.foreground": "#b89578",
		"activityBar.activeBorder": "#a07b5c",
		"activityBar.inactiveForeground": "#b89578"
	},

	// Tab / indents
	"editor.insertSpaces": false,
	"editor.tabSize": 4,

	// Typescript
	"js/ts.tsdk.path": "node_modules\\typescript\\lib", // use project's local TypeScript version
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports": "explicit"
	},
}
